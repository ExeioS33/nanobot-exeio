{{ ansible_managed | comment }}
# Two jobs, one file:
#  1. Docker Compose auto-loads a ".env" from this directory for ${VAR}
#     substitution INSIDE docker-compose.yml itself (e.g. the NANOBOT_CHANNELS
#     build arg) — this happens at `docker compose` parse time.
#  2. docker-compose.override.yml.j2 also points `env_file:` at this same
#     file, injecting these vars into the CONTAINER's runtime environment —
#     this is what lets config.json's "${TELEGRAM_BOT_API_KEY}"-style
#     interpolation resolve inside the running process.
# These are two genuinely different consumption points; using one file for
# both is a simplification, not a coincidence.

# --- Compose build args ---
NANOBOT_CHANNELS={{ nanobot_channels }}

# --- Provider keys (config.json.j2 references these via ${VAR}) ---
TOGETHER_AI_API_KEY={{ vault_together_ai_api_key }}
NVIDIA_API_KEY={{ vault_nvidia_api_key }}
GROQ_API_KEY={{ vault_groq_api_key }}

# --- Telegram ---
TELEGRAM_BOT_API_KEY={{ vault_telegram_bot_api_key }}

# --- Langfuse observability (optional) ---
LANGFUSE_SECRET_KEY={{ vault_langfuse_secret_key }}
LANGFUSE_PUBLIC_KEY={{ vault_langfuse_public_key }}
LANGFUSE_BASE_URL={{ vault_langfuse_base_url }}
